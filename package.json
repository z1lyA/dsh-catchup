{
  "name": "dsh-catchup",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "右侧栏「接上」：切回一个会话之前，先看清它停在哪、有没有事等你拍板。零模型调用。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "session", "sidebar"],
  "license": "MIT",
  "author": "Ziz1",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node test/logic.test.mjs && node test/render.test.mjs && node test/host.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
